{
  "manifest_version": 3,
  "name": "PostScrapedIn - LinkedIn Post Exporter",
  "version": "1.0.0",
  "description": "Offline-first Chrome extension to export your published LinkedIn posts to clean text and JSON.",
  "permissions": [
    "cookies",
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PostScrapedIn"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
